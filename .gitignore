# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- Builds do PyInstaller ---
build/
dist/
*.spec.bak

# --- Seus dados pessoais (biblioteca, cache, capas, sessao) ---
data/

# --- Executaveis: grandes demais para o Git ---
