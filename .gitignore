*.exe
site/AptPlayer.exe
site/AptPlayer-Setup.exe

# --- Segredos ---
# core/account.py leva as chaves do Supabase depois de configurado.
# A chave anon e publica por design, mas nao ha motivo para versiona-la.
.env
secrets.json

# --- Sistema ---
Thumbs.db
desktop.ini
.DS_Store

# Pacotes do site (grandes)
site/*.zip
docs/*.zip

# Token do GitHub (nunca versionar)
.github-token
